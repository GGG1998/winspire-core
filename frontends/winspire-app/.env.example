# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase API URL (for local development: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon/Public Key (get from: supabase status)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: API Base URL for other backend services
# Empty by default - endpoints use full paths (e.g., /v1/matchmaking/...)
VITE_API_BASE_URL=http://localhost

# WebSocket Configuration
# Matchmaking WebSocket Base URL (host only, without path)
# Routes through Traefik (API Gateway) on port 80
# Endpoints already include full paths like /v1/matchmaking/tournaments/...
# Format: ws://host (without path)
# For local development with Traefik: ws://localhost
VITE_MATCHMAKING_WS_URL=ws://localhost
