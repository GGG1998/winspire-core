# Supabase Development Configuration
# Copy this file to .env and update the values

# Database
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
DB_PORT=3020

# JWT
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# API Keys (for development - use demo keys)
# Generate production keys using: supabase gen keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Studio Configuration
DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_PROJECT_NAME=Default Project
STUDIO_PORT=3011

# Site Configuration
SITE_URL=http://localhost:3011
SUPABASE_PUBLIC_URL=http://localhost:3018
API_EXTERNAL_URL=http://localhost:3018

# Auth Configuration
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
URI_ALLOW_LIST=

# PostgREST Configuration
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
REST_PORT=3012

# Service Ports
AUTH_PORT=3013
REALTIME_PORT=3014
STORAGE_PORT=3015
IMGPROXY_PORT=3016
META_PORT=3017
KONG_HTTP_PORT=3018
KONG_HTTPS_PORT=3019

# Storage Configuration
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
TENANT_ID=stub
REGION=stub
GLOBAL_S3_BUCKET=stub

# Image Proxy
IMGPROXY_ENABLE_WEBP_DETECTION=true
