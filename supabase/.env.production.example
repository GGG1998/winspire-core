# Supabase Production Configuration
# Copy this file to .env.production and update ALL values with secure, randomly generated keys
# NEVER commit the actual .env.production file to version control

# Database
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
DB_PORT=5432

# JWT
# Generate with: openssl rand -base64 64 (minimum 32 characters, recommended 64+)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_JWT_SECRET
JWT_EXP=3600

# API Keys
# Generate using Supabase CLI: supabase gen keys
# Or manually create JWT tokens with:
#   - ANON_KEY: role=anon, exp=future_date
#   - SERVICE_ROLE_KEY: role=service_role, exp=future_date
ANON_KEY=CHANGE_ME_GENERATE_ANON_KEY
SERVICE_ROLE_KEY=CHANGE_ME_GENERATE_SERVICE_ROLE_KEY

# Studio Configuration
DEFAULT_ORGANIZATION_NAME=Your Organization
DEFAULT_PROJECT_NAME=Your Project
STUDIO_PORT=3011

# Site Configuration
# Update with your production domain
SITE_URL=https://your-domain.com
SUPABASE_PUBLIC_URL=https://api.your-domain.com
API_EXTERNAL_URL=https://api.your-domain.com

# Auth Configuration
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
# Add allowed redirect URIs separated by commas
URI_ALLOW_LIST=https://your-domain.com,https://www.your-domain.com

# PostgREST Configuration
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
REST_PORT=3012

# Service Ports (adjust based on your infrastructure)
# Note: In production, these may be behind a reverse proxy/load balancer
AUTH_PORT=3013
REALTIME_PORT=3014
STORAGE_PORT=3015
IMGPROXY_PORT=3016
META_PORT=3017
KONG_HTTP_PORT=3018
KONG_HTTPS_PORT=3019

# Storage Configuration
FILE_SIZE_LIMIT=52428800
# For production, use S3 instead of file storage
STORAGE_BACKEND=s3
# AWS S3 Configuration (required when STORAGE_BACKEND=s3)
TENANT_ID=your-tenant-id
REGION=us-east-1
GLOBAL_S3_BUCKET=your-s3-bucket-name
# Add these if using S3:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Image Proxy
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Security Notes:
# 1. Generate all secrets using cryptographically secure random generators
# 2. Use different keys for each environment (dev, staging, prod)
# 3. Rotate keys regularly
# 4. Never expose SERVICE_ROLE_KEY in client-side code
# 5. Use environment-specific .env files
# 6. Store production secrets in a secure secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
