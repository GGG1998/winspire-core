# {{ cookiecutter.service_name | title }} Service Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=development

# Service Configuration
SERVICE_PORT={{ cookiecutter.service_port }}

# Database Configuration
POSTGRES_DSN=postgresql://postgres:postgres@localhost:54322/{{ cookiecutter.db_name }}?sslmode=disable

{% if cookiecutter.use_redis == "true" %}
# Redis Configuration
REDIS_ADDR=localhost:6379
{% endif %}

# HTTP Timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
SHUTDOWN_GRACE=10s

# JWT Authentication (Supabase configuration)
# Required for authentication middleware
HOST_JWT_SECRET=your-jwt-secret-here
HOST_JWT_ISSUER=https://your-project.supabase.co/auth/v1
HOST_JWT_AUDIENCE=authenticated

# Logging
LOG_LEVEL=info
