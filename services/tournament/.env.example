# Competition Service Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=development

# Service Configuration
SERVICE_PORT=8089

# Database Configuration (Supabase local)
POSTGRES_DSN=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379

# HTTP Timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
SHUTDOWN_GRACE=10s

# JWT Authentication (Supabase configuration)
# Required for authentication middleware
HOST_JWT_SECRET=your-jwt-secret-here
HOST_JWT_ISSUER=https://your-project.supabase.co/auth/v1
HOST_JWT_AUDIENCE=authenticated

# External Services
MATCHMAKING_BASE_URL=http://localhost:8081
GAME_MANAGEMENT_URL=http://localhost:8083

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=*/2 * * * *

# Logging
LOG_LEVEL=debug
