# Game Management Service Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=development

# Service Configuration
SERVICE_PORT=8085

# Database Configuration (Supabase local)
POSTGRES_DSN=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379

# HTTP Timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
SHUTDOWN_GRACE=10s

# JWT Authentication (Supabase configuration)
# Required for authentication middleware
HOST_JWT_SECRET=your-jwt-secret-here
HOST_JWT_ISSUER=https://your-project.supabase.co/auth/v1
HOST_JWT_AUDIENCE=authenticated

# AWS S3 Configuration (for game bundles storage)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=games
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Internal Service Access (for service-to-service communication)
GAME_MANAGEMENT_INTERNAL_API_KEY=your-internal-api-key

# Cache Configuration
BUNDLE_CACHE_TTL=1h

# Logging
LOG_LEVEL=info
