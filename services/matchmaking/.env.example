# Matchmaking Service Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8081
GIN_MODE=release

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication (Supabase configuration)
HOST_JWT_SECRET=your-jwt-secret-here
HOST_JWT_ISSUER=https://your-project.supabase.co/auth/v1
HOST_JWT_AUDIENCE=authenticated

# Game API Configuration (optional - for external game APIs)
GAME_API_URL=
GAME_API_KEY=
GAME_API_POLL_INTERVAL=5s
GAME_API_POLL_TIMEOUT=60s
GAME_API_CIRCUIT_BREAKER_THRESHOLD=5
GAME_API_CIRCUIT_BREAKER_TIMEOUT=30s

# External Services
COMPETITION_SERVICE_URL=http://localhost:8089
GAME_MANAGEMENT_URL=http://localhost:8083

# Supabase Configuration (for storage)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key

# Observability
LOG_LEVEL=debug
LOG_FORMAT=json
CLOUDWATCH_REGION=eu-central-1
CLOUDWATCH_LOG_GROUP=/aws/ecs/matchmaking
CLOUDWATCH_NAMESPACE=Winspire/Matchmaking

# Feature Flags
ENABLE_WEBSOCKET_LOBBIES=true
ENABLE_AUTO_SCORE_RETRIEVAL=true
ENABLE_DISCONNECT_HANDLING=true

# Timeouts
LOBBY_JOIN_TIMEOUT=2m
DISCONNECT_RECONNECT_WINDOW=30s
READY_CHECK_TIMEOUT=5m

# Limits
MAX_CONCURRENT_TOURNAMENTS=50
MAX_PARTICIPANTS_PER_TOURNAMENT=256
