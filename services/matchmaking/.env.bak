# Matchmaking Service Environment Variables
# Local development configuration

# Server Configuration
PORT=8088
GIN_MODE=debug

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication (leave empty to use insecure default in development)
HOST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
HOST_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
HOST_JWT_AUDIENCE=

# Game API Configuration (optional)
GAME_API_URL=
GAME_API_KEY=
GAME_API_POLL_INTERVAL=5s
GAME_API_POLL_TIMEOUT=60s
GAME_API_CIRCUIT_BREAKER_THRESHOLD=5
GAME_API_CIRCUIT_BREAKER_TIMEOUT=30s

# External Services
COMPETITION_SERVICE_URL=http://localhost:80
GAME_MANAGEMENT_URL=http://localhost:80

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Observability
LOG_LEVEL=debug
LOG_FORMAT=json
CLOUDWATCH_REGION=eu-central-1
CLOUDWATCH_LOG_GROUP=/aws/ecs/matchmaking
CLOUDWATCH_NAMESPACE=Winspire/Matchmaking

# Feature Flags
ENABLE_WEBSOCKET_LOBBIES=true
ENABLE_AUTO_SCORE_RETRIEVAL=true
ENABLE_DISCONNECT_HANDLING=true

# Timeouts
LOBBY_JOIN_TIMEOUT=2m
DISCONNECT_RECONNECT_WINDOW=30s
READY_CHECK_TIMEOUT=5m

# Limits
MAX_CONCURRENT_TOURNAMENTS=50
MAX_PARTICIPANTS_PER_TOURNAMENT=256
