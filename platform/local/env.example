# Local Development Environment Variables
# Copy this file to .env and fill in your values

# Supabase JWT Configuration (required)
# Get from: supabase start (look for "JWT secret" in output)
HOST_JWT_SECRET=your-jwt-secret-from-supabase-start
HOST_JWT_ISSUER=http://host.docker.internal:54321/auth/v1
HOST_JWT_AUDIENCE=authenticated

# Supabase Storage (for game-management)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-start

# Database (Supabase local - default port 54322)
POSTGRES_DSN=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable


