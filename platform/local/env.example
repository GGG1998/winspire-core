# Local Development Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Supabase Configuration (required)
# =============================================================================
# Get from: supabase start (look for "JWT secret" in output)
HOST_JWT_SECRET=your-jwt-secret-from-supabase-start
HOST_JWT_ISSUER=http://host.docker.internal:54321/auth/v1
HOST_JWT_AUDIENCE=authenticated

# Supabase Storage (for game-management)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-start

# Database (Supabase local - default port 54322)
POSTGRES_DSN=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable

# =============================================================================
# LocalStack Configuration (for local AWS emulation)
# =============================================================================
# These are used by LocalStack for local development
# No real AWS credentials needed for local development
LOCALSTACK_DEBUG=0
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# AWS Configuration (for production deployments)
# =============================================================================
# Only needed when deploying to AWS (not for local development)
AWS_REGION=eu-central-1
# Can be either a bucket name or an access point ARN like:
# arn:aws:s3:eu-central-1:123456789012:accesspoint/game-myproject
AWS_S3_BUCKET=
# Leave empty for local development, fill for AWS deployments
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
